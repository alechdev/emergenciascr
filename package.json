{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:sync": "bun run --cwd apps/sync-v2 dev",
    "dev:all": "concurrently --names web,sync --prefix-colors auto \"bun run --cwd apps/web dev\" \"bun run --cwd apps/sync-v2 dev\"",
    "lint:check": "bun run --cwd apps/web lint",
    "lint:safefix": "bun run --cwd apps/web lint:fix",
    "lint:next": "next lint",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "format:check": "bun run --cwd apps/web format:check",
    "format": "bun run --cwd apps/web format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260210.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "0.31.0",
    "oxlint": "1.46.0",
    "oxlint-tsgolint": "0.12.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx,html,yml,yaml}": "bunx oxfmt"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9"
}
