NODE_ENV=development
LOG_LEVEL=info

DRIZZLE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/emergenciascr
REDIS_URL=redis://localhost:6379

SIGAE_API_URL=
SIGAE_IP=
SIGAE_USER=
