NODE_ENV=development
LOG_LEVEL=info

# Percent-encode the user and password if they contain URL delimiters such as / ? # @ :
DRIZZLE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/emergenciascr
REDIS_URL=redis://localhost:6379

SIGAE_API_URL=
SIGAE_IP=
SIGAE_USER=
SIGAE_PASSWORD=
SIGAE_COD_SYS=
# Optional: http(s)://user:password@host:port
SIGAE_PROXY_URL=

# Internal health check (GET /health). Loopback by default; set HEALTH_HOST=0.0.0.0 when
# the check runs from outside the container.
HEALTH_PORT=8080
HEALTH_HOST=

# Optional: telemetry export is off when the endpoint is unset
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sync-v2
OTEL_RESOURCE_ATTRIBUTES=
