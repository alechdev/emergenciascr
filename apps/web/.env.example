NODE_ENV=development

# Vite / Start listen on :3000 and also serve Hono at /api (see vite-hono-api.ts + server.ts).

# Build-time: baked into the client bundle by Vite.
# Same-origin API: http://localhost:3000/api (or omit; client falls back to /api)
VITE_SERVER_URL=http://localhost:3000/api
VITE_BASE=/
VITE_MAPBOX_TOKEN=
VITE_SITE_URL=http://localhost:3000

# Runtime: SSR internal API calls (same process / same origin).
SERVER_INTERNAL_URL=http://localhost:3000/api
SITEMAP_TOKEN=

# --- Hono API (api/) ---
LOG_LEVEL=debug
API_URL=http://localhost:3000/api
INTERNAL_API_URL=http://localhost:3000
MAPBOX_API_KEY=

IMGPROXY_BASE_URL=http://localhost:8080
IMGPROXY_KEY=
IMGPROXY_SALT=
IMGPROXY_TOKEN=

S3_ENDPOINT=http://localhost:9000
S3_KEY_ID=
S3_SECRET_KEY=
S3_BUCKET_NAME=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emergenciascr
DRIZZLE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/emergenciascr

ADMIN_TOKEN=
SIGAE_API_URL=
SIGAE_IP=
SIGAE_USER=
SIGAE_PASSWORD=
SIGAE_COD_SYS=

SKIP_ENV_CHECK=
