NODE_ENV=development
LOG_LEVEL=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emergenciascr
DRIZZLE_POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379

SIGAE_API_URL=
SIGAE_IP=
SIGAE_USER=
SIGAE_PASSWORD=
SIGAE_COD_SYS=
# Optional: http(s)://user:password@host:port
SIGAE_PROXY_URL=

# Internal health check (GET /health). Loopback by default; set HEALTH_HOST=0.0.0.0 when
# the check runs from outside the container.
HEALTH_PORT=8080
HEALTH_HOST=

# Optional: telemetry export is off when the endpoint is unset
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sync-v2
OTEL_RESOURCE_ATTRIBUTES=
