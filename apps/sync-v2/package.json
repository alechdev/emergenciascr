{
  "name": "sync-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "bun run --no-install dist/index.mjs",
    "adopt-legacy-open": "bun run --no-install dist/adopt-legacy-open.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@bomberoscr/db": "workspace:*",
    "@bomberoscr/sigae": "workspace:*",
    "@bomberoscr/sync-domain": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/winston-transport": "^0.16.0",
    "bullmq": "^5.56.0",
    "bullmq-otel": "^1.0.1",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.2",
    "ioredis": "^5.6.1",
    "neverthrow": "^8.2.0",
    "tsx": "^4.20.3",
    "winston": "^3.17.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@bomberoscr/typescript-config": "workspace:*",
    "@types/node": "^20.19.1",
    "@typescript/native-preview": "^7.0.0-dev.20260127.1",
    "@vitest/ui": "^3.2.4",
    "tsdown": "0.19.0",
    "vitest": "^3.2.4"
  }
}
